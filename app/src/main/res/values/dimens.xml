    <!-- ================================================================ -->
    <dimen name="radius_none">0dp</dimen>
    <dimen name="radius_small">8dp</dimen>
    <dimen name="radius_medium">12dp</dimen>
    <dimen name="radius_large">16dp</dimen>
    <dimen name="radius_xlarge">24dp</dimen>

