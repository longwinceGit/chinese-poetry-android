<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- 结算视图：大星弹跳 + 滚动得分 + 最美一句卡片 -->
    <com.poetry.ui.widget.SettlementView
        android:id="@+id/settlement_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_settlement_replay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- M10 名句彩卡：本局遇到 88 首释义诗时额外弹卡（默认 GONE，由 Fragment 按 hasExplanation 显示） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_famous"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginStart="@dimen/spacing_xxl"
        android:layout_marginEnd="@dimen/spacing_xxl"
        android:layout_marginTop="@dimen/spacing_md"
        android:minHeight="56dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/bg_card"
        app:layout_constraintTop_toBottomOf="@id/settlement_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:id="@+id/tv_famous_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settlement_famous_card_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tv_famous_poem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="40dp"
                android:textSize="14sp"
                android:textColor="@color/text_body"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 再来一局 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settlement_replay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginStart="@dimen/spacing_xxl"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md"
        android:text="@string/settlement_replay"
        android:textSize="@dimen/text_size_body"
        android:contentDescription="@string/settlement_replay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_settlement_back_home" />

    <!-- 回大厅 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settlement_back_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_xxl"
        android:layout_marginBottom="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md"
        android:text="@string/settlement_back_home"
        android:textSize="@dimen/text_size_body"
        android:contentDescription="@string/settlement_back_home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_settlement_replay"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
