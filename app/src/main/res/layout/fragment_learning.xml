<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/spacing_page_bottom">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_page_top"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            android:text="@string/learn_title"
            android:textAppearance="@style/TextAppearance.Poetry.PageTitle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ===== 学习统计卡片 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_stats"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_xl_2"
                android:gravity="center">

                <!-- 连续天数 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_streak_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_stat"
                        android:textColor="@color/text_accent"
                        android:contentDescription="@string/a11y_streak_count"
                        android:textStyle="bold"
                        tools:text="7" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/learn_streak"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_body_secondary" />
                    <TextView
                        android:id="@+id/tv_streak_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_label_sm"
                        android:textColor="@color/text_caption"
                        tools:text="连续7天" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/height_divider"
                    android:layout_height="@dimen/size_icon_lg"
                    android:background="@color/divider_default" />

                <!-- 已学诗词数 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_learned_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/a11y_learned_count"
                        android:textSize="@dimen/text_size_stat"
                        android:textColor="@color/text_title"
                        android:textStyle="bold"
                        tools:text="42" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/learn_total_learned"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_body_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/height_divider"
                    android:layout_height="@dimen/size_icon_lg"
                    android:background="@color/divider_default" />

                <!-- 等级 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/a11y_user_level"
                        android:textSize="@dimen/text_size_stat"
                        android:textColor="@color/text_gold"
                        android:textStyle="bold"
                        tools:text="5" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="等级"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_body_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 学习趋势图表 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_chart"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            app:layout_constraintTop_toBottomOf="@id/card_stats"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="学习趋势"
                    android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/learn_chart_subtitle"
                    android:textSize="@dimen/text_size_label"
                    android:textColor="@color/text_body_secondary" />

                <com.poetry.ui.widget.StatsBarChart
                    android:id="@+id/chart_stats"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingTop="@dimen/spacing_sm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 打卡日历 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_checkin"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            app:layout_constraintTop_toBottomOf="@id/card_chart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/learn_weekly_calendar"
                    android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

                <LinearLayout
                    android:id="@+id/ll_calendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="horizontal"
                    android:gravity="center" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 每日任务 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_tasks"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            app:layout_constraintTop_toBottomOf="@id/card_checkin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/learn_daily_tasks"
                    android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

                <LinearLayout
                    android:id="@+id/ll_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
