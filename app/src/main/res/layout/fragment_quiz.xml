<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:padding="@dimen/spacing_page_horizontal">

    <LinearLayout
        android:id="@+id/ll_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✏️ 填空挑战"
            android:textSize="@dimen/text_size_headline"
            android:textColor="@color/text_title"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_headline"
            android:textColor="@color/text_gold"
            android:textStyle="bold"
            tools:text="得分: 0" />

        <TextView
            android:id="@+id/btn_read_poem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/game_read"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="🔊"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- M3 对诗化：局内反馈层（星星进度环 + 连击条 + 飞分），由 Fragment 动态 addView -->
    <FrameLayout
        android:id="@+id/fl_feedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        app:layout_constraintTop_toBottomOf="@id/ll_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:textSize="@dimen/text_size_label"
        android:textColor="@color/text_body_secondary"
        app:layout_constraintTop_toBottomOf="@id/fl_feedback"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="第 1/5 题" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xxl"
        android:textSize="@dimen/text_size_title"
        android:textColor="@color/text_body_secondary"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="《静夜思》— 李白" />

    <!-- 诗句展示 + 候选字 + 反馈：内容多时可滚动，不遮挡底部提交按钮 -->
    <ScrollView
        android:id="@+id/sv_quiz_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_xxl"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintBottom_toTopOf="@id/btn_submit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_poem_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_candidates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl_2"
                app:chipSpacingHorizontal="@dimen/spacing_chip_gap"
                app:chipSpacingVertical="@dimen/spacing_chip_gap" />

            <!-- M3 对诗化：内联答题反馈（正确/错误），Fragment 动态控制 -->
            <TextView
                android:id="@+id/tv_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:textSize="@dimen/text_size_body"
                android:gravity="center"
                android:visibility="gone"
                tools:text="✅ 全对！" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_submit"
        style="@style/Widget.Poetry.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_touch_target"
        android:text="提交答案"
        android:textSize="@dimen/text_size_body"
        app:cornerRadius="@dimen/radius_medium"
        app:layout_constraintBottom_toTopOf="@id/btn_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_touch_target"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/game_next"
        android:textSize="@dimen/text_size_body"
        app:cornerRadius="@dimen/radius_medium"
        app:icon="@drawable/ic_learn"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
