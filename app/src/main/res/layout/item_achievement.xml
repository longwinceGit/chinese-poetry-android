<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/spacing_lg"
    android:background="@drawable/bg_chip"
    android:layout_marginBottom="@dimen/spacing_md">

    <TextView
        android:id="@+id/tv_achv_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:textSize="@dimen/text_size_icon_emoji" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_lg">

        <TextView
            android:id="@+id/tv_achv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Poetry.CardTitle"
            android:textColor="@color/text_body" />

        <TextView
            android:id="@+id/tv_achv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_label"
            android:textColor="@color/text_body_secondary"
            android:layout_marginTop="@dimen/spacing_xs" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_achv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_label"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:background="@drawable/bg_chip" />

</LinearLayout>
