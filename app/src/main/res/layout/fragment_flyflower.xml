<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:padding="@dimen/spacing_page_horizontal">

    <!-- 标题 + 倒计时 header 行 -->
    <LinearLayout
        android:id="@+id/ll_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/flyflower_title"
            android:textSize="@dimen/text_size_headline"
            android:textColor="@color/text_title"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/tv_fly_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_headline"
            android:textColor="@color/text_gold"
            android:textStyle="bold"
            tools:text="⏱ 60秒" />
    </LinearLayout>

    <!-- 局内反馈层（星星进度环 + 连击条 + 飞分），由 Fragment 动态 addView -->
    <FrameLayout
        android:id="@+id/fl_feedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        app:layout_constraintTop_toBottomOf="@id/ll_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 命中计数 -->
    <TextView
        android:id="@+id/tv_fly_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:textSize="@dimen/text_size_label"
        android:textColor="@color/text_body_secondary"
        app:layout_constraintTop_toBottomOf="@id/fl_feedback"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="已接 0 句" />

    <!-- 题目区：主题字 + 读题 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_question"
        style="@style/Widget.Poetry.Card.Raised"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl_2"
        app:layout_constraintTop_toBottomOf="@id/tv_fly_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_fly_keyword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_headline"
                android:textColor="@color/text_body"
                android:gravity="center"
                android:padding="@dimen/spacing_xxl"
                android:fontFamily="serif"
                tools:text="月" />

            <TextView
                android:id="@+id/tv_fly_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/text_body_secondary"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingBottom="@dimen/spacing_md"
                tools:text="说一句带「月」的诗" />

            <!-- 🔊 读题按钮 -->
            <TextView
                android:id="@+id/btn_fly_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:minHeight="@dimen/height_touch_target"
                android:minWidth="48dp"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_md"
                android:text="@string/couplet_read"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/text_body_secondary"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 输入行：EditText + 对令按钮 -->
    <LinearLayout
        android:id="@+id/ll_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/card_question"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/et_fly_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/flyflower_input_hint"
            android:inputType="text"
            android:maxLength="20"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/text_body"
            android:textColorHint="@color/text_caption"
            android:background="@drawable/bg_chip"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:minHeight="@dimen/height_touch_target" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fly_submit"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:text="@string/flyflower_submit"
            android:textSize="@dimen/text_size_body"
            app:cornerRadius="@dimen/radius_medium" />
    </LinearLayout>

    <!-- 「📖 提示一句」按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_fly_hint"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/flyflower_hint_button"
        android:textSize="@dimen/text_size_body"
        app:cornerRadius="@dimen/radius_medium"
        app:layout_constraintTop_toBottomOf="@id/ll_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 候选句容器（默认隐藏，点「提示一句」后显示；内容多时可滚动，不遮挡底部按钮） -->
    <ScrollView
        android:id="@+id/sv_candidates"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:fillViewport="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btn_fly_hint"
        app:layout_constraintBottom_toTopOf="@id/btn_fly_restart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/ll_candidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 再来一局（固定在底部） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_fly_restart"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/spacing_xxl"
        android:text="@string/flyflower_restart"
        android:textSize="@dimen/text_size_body"
        app:cornerRadius="@dimen/radius_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
