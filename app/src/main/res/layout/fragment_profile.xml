<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/spacing_page_bottom">

        <!-- 头像区域 -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_page_top"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_avatar"
                android:layout_width="@dimen/size_avatar"
                android:layout_height="@dimen/size_avatar"
                android:text="📚"
                android:contentDescription="@string/a11y_avatar_emoji"
                android:textSize="@dimen/text_size_avatar"
                android:gravity="center"
                android:background="@drawable/bg_checkin_future" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_lg"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_level_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_body_sm"
                    android:textColor="@color/text_gold"
                    tools:text="等级 5" />

                <ProgressBar
                    android:id="@+id/progress_exp"
                    android:contentDescription="@string/a11y_progress_exp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:progressTint="@color/score_gold"
                    android:progressBackgroundTint="@color/bg_card_elevated"
                    tools:progress="60" />

                <TextView
                    android:id="@+id/tv_exp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textSize="@dimen/text_size_label_sm"
                    android:textColor="@color/text_body_secondary"
                    tools:text="120 / 200 经验" />
            </LinearLayout>
        </LinearLayout>

        <!-- 统计卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_favorites"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_page_top"
            android:layout_marginEnd="@dimen/spacing_md"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/card_learned"
            app:layout_constraintTop_toBottomOf="@id/header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️"
                    android:textSize="@dimen/text_size_icon_emoji" />
                <TextView
                    android:id="@+id/tv_favorites_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:textSize="@dimen/text_size_display_sm"
                    android:textColor="@color/text_title"
                    android:textStyle="bold"
                    tools:text="15" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_favorites"
                    android:textSize="@dimen/text_size_label_sm"
                    android:textColor="@color/text_body_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_learned"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_page_top"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            android:layout_marginStart="@dimen/spacing_md"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_favorites"
            app:layout_constraintTop_toBottomOf="@id/header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖"
                    android:textSize="@dimen/text_size_icon_emoji" />
                <TextView
                    android:id="@+id/tv_learned_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:textSize="@dimen/text_size_display_sm"
                    android:textColor="@color/text_title"
                    android:textStyle="bold"
                    tools:text="42" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_learned"
                    android:textSize="@dimen/text_size_label_sm"
                    android:textColor="@color/text_body_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 成就区域 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_achievements"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            app:layout_constraintTop_toBottomOf="@id/card_favorites"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_achievements"
                        android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

                    <TextView
                        android:id="@+id/tv_achievement_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_body_secondary"
                        tools:text="3/12" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_achievements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="horizontal"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 主题展示区域 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_themes"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            app:layout_constraintTop_toBottomOf="@id/card_achievements"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="主题装扮"
                        android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

                    <TextView
                        android:id="@+id/tv_theme_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_body_secondary"
                        tools:text="1/9" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_themes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="horizontal"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 分享按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_app"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_button"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            android:text="@string/profile_share_app"
            android:textSize="@dimen/text_size_body"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_icon_text"
            app:cornerRadius="@dimen/radius_medium"
            app:layout_constraintTop_toBottomOf="@id/card_themes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 调试日志入口 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_debug_log"
            style="@style/Widget.Poetry.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_touch_target"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            android:text="@string/profile_debug_log"
            android:textSize="@dimen/text_size_body"
            app:cornerRadius="@dimen/radius_medium"
            app:layout_constraintTop_toBottomOf="@id/btn_share_app"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
