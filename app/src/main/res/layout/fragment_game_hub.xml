<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:paddingStart="@dimen/spacing_page_horizontal"
    android:paddingEnd="@dimen/spacing_page_horizontal"
    android:paddingTop="@dimen/spacing_page_top">

    <TextView
        android:id="@+id/tv_game_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/game_title"
        android:textAppearance="@style/TextAppearance.Poetry.PageTitle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_game_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/game_subtitle"
        android:textAppearance="@style/TextAppearance.Poetry.BodySecondary"
        app:layout_constraintTop_toBottomOf="@id/tv_game_title"
        app:layout_constraintStart_toStartOf="@id/tv_game_title" />

    <!-- 对诗 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_couplet"
        android:contentDescription="@string/a11y_game_couplet_card"
        style="@style/Widget.Poetry.Card.Raised"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xxl"
        app:layout_constraintTop_toBottomOf="@id/tv_game_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_xl_2"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="@dimen/size_icon_lg"
                android:layout_height="@dimen/size_icon_lg"
                android:text="📝"
                android:textSize="@dimen/text_size_game_icon"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:background="@drawable/bg_checkin_future" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_couplet"
                    android:textSize="@dimen/text_size_title"
                    android:textColor="@color/text_body"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/game_couplet_desc"
                    android:textSize="@dimen/text_size_label"
                    android:textColor="@color/text_body_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:importantForAccessibility="no"
                android:textSize="@dimen/text_size_headline"
                android:textColor="@color/text_caption" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 消消乐 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_match"
        android:contentDescription="@string/a11y_game_match_card"
        style="@style/Widget.Poetry.Card.Raised"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        app:layout_constraintTop_toBottomOf="@id/card_couplet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_xl_2"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="@dimen/size_icon_lg"
                android:layout_height="@dimen/size_icon_lg"
                android:text="🃏"
                android:textSize="@dimen/text_size_game_icon"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:background="@drawable/bg_checkin_future" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_match"
                    android:textSize="@dimen/text_size_title"
                    android:textColor="@color/text_body"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/game_match_desc"
                    android:textSize="@dimen/text_size_label"
                    android:textColor="@color/text_body_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:importantForAccessibility="no"
                android:textSize="@dimen/text_size_headline"
                android:textColor="@color/text_caption" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 填空 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_quiz"
        android:contentDescription="@string/a11y_game_quiz_card"
        style="@style/Widget.Poetry.Card.Raised"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        app:layout_constraintTop_toBottomOf="@id/card_match"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_xl_2"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="@dimen/size_icon_lg"
                android:layout_height="@dimen/size_icon_lg"
                android:text="✏️"
                android:textSize="@dimen/text_size_game_icon"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:background="@drawable/bg_checkin_future" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_quiz"
                    android:textSize="@dimen/text_size_title"
                    android:textColor="@color/text_body"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/game_quiz_desc"
                    android:textSize="@dimen/text_size_label"
                    android:textColor="@color/text_body_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:importantForAccessibility="no"
                android:textSize="@dimen/text_size_headline"
                android:textColor="@color/text_caption" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
