<?xml version="1.0" encoding="utf-8"?>
<!--
  游戏大厅：标题 + 自动读题开关 + 续局横幅 + 游戏卡片 2 列网格。
  根容器为 NestedScrollView —— 卡片超出一屏时可滚动，飞花令/作者连线不被遮挡。
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_page"
    android:paddingStart="@dimen/spacing_page_horizontal"
    android:paddingEnd="@dimen/spacing_page_horizontal"
    android:paddingTop="@dimen/spacing_page_top">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/spacing_xl_2">

        <TextView
            android:id="@+id/tv_game_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_title"
            android:textAppearance="@style/TextAppearance.Poetry.PageTitle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_game_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/game_subtitle"
            android:textAppearance="@style/TextAppearance.Poetry.BodySecondary"
            app:layout_constraintTop_toBottomOf="@id/tv_game_title"
            app:layout_constraintStart_toStartOf="@id/tv_game_title" />

        <!-- 最近有趣视线 -->
        <TextView
            android:id="@+id/tv_game_recall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/game_recall"
            android:textSize="@dimen/text_size_label"
            android:textColor="@color/text_gold"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_game_subtitle"
            app:layout_constraintStart_toStartOf="@id/tv_game_title"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- M10 自动读题开关（进题自动轻声朗读，默认开） -->
        <LinearLayout
            android:id="@+id/row_auto_read"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_sm"
            app:layout_constraintTop_toBottomOf="@id/tv_game_recall"
            app:layout_constraintStart_toStartOf="@id/tv_game_title"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/menu_auto_read"
                android:textSize="@dimen/text_size_label"
                android:textColor="@color/text_body" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_auto_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:contentDescription="@string/menu_auto_read" />
        </LinearLayout>

        <!-- M9 容错续局：继续上次（未完成局快照存在时显示） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_continue"
            android:contentDescription="@string/continue_game_hint"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="@dimen/spacing_lg"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/row_auto_read"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_continue_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_xl_2"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/text_body"
                android:textStyle="bold"
                tools:text="↩️ 继续上次！你上次玩到一半的是 对诗" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ 游戏卡片 2 列网格 ============ -->

        <!-- 对诗 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_couplet"
            android:contentDescription="@string/a11y_game_couplet_card"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:layout_marginEnd="@dimen/spacing_md"
            app:layout_constraintTop_toBottomOf="@id/card_continue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/card_match">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/icon_couplet"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_touch_target"
                    android:text="📝"
                    android:textSize="@dimen/text_size_game_icon"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:background="@drawable/bg_checkin_future"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/info_couplet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/spacing_xs"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:layout_constraintTop_toBottomOf="@id/icon_couplet"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/game_couplet"
                        android:textSize="@dimen/text_size_title"
                        android:textColor="@color/text_body"
                        android:textStyle="bold"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/game_couplet_desc"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_body_secondary"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- 星标 + 最高分 -->
                    <TextView
                        android:id="@+id/score_couplet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_gold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 今日角标 -->
                <TextView
                    android:id="@+id/badge_couplet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/bg_chip"
                    android:textSize="@dimen/text_size_label_sm"
                    android:textColor="@color/on_surface_variant"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 消消乐 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_match"
            android:contentDescription="@string/a11y_game_match_card"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:layout_marginStart="@dimen/spacing_md"
            app:layout_constraintTop_toBottomOf="@id/card_continue"
            app:layout_constraintStart_toEndOf="@id/card_couplet"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/icon_match"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_touch_target"
                    android:text="🃏"
                    android:textSize="@dimen/text_size_game_icon"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:background="@drawable/bg_checkin_future"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/info_match"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/spacing_xs"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:layout_constraintTop_toBottomOf="@id/icon_match"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/game_match"
                        android:textSize="@dimen/text_size_title"
                        android:textColor="@color/text_body"
                        android:textStyle="bold"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/game_match_desc"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_body_secondary"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/score_match"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_gold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badge_match"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/bg_chip"
                    android:textSize="@dimen/text_size_label_sm"
                    android:textColor="@color/on_surface_variant"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 填空 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_quiz"
            android:contentDescription="@string/a11y_game_quiz_card"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/spacing_md"
            app:layout_constraintTop_toBottomOf="@id/card_match"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/card_flyflower">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/icon_quiz"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_touch_target"
                    android:text="✏️"
                    android:textSize="@dimen/text_size_game_icon"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:background="@drawable/bg_checkin_future"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/info_quiz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/spacing_xs"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:layout_constraintTop_toBottomOf="@id/icon_quiz"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/game_quiz"
                        android:textSize="@dimen/text_size_title"
                        android:textColor="@color/text_body"
                        android:textStyle="bold"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/game_quiz_desc"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_body_secondary"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/score_quiz"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_gold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badge_quiz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/bg_chip"
                    android:textSize="@dimen/text_size_label_sm"
                    android:textColor="@color/on_surface_variant"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 飞花令 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_flyflower"
            android:contentDescription="@string/a11y_game_flyflower_card"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginStart="@dimen/spacing_md"
            app:layout_constraintTop_toBottomOf="@id/card_match"
            app:layout_constraintStart_toEndOf="@id/card_quiz"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/icon_flyflower"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_touch_target"
                    android:text="🎤"
                    android:textSize="@dimen/text_size_game_icon"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:background="@drawable/bg_checkin_future"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/info_flyflower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/spacing_xs"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:layout_constraintTop_toBottomOf="@id/icon_flyflower"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/game_flyflower"
                        android:textSize="@dimen/text_size_title"
                        android:textColor="@color/text_body"
                        android:textStyle="bold"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/game_flyflower_desc"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_body_secondary"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/score_flyflower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_gold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badge_flyflower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/bg_chip"
                    android:textSize="@dimen/text_size_label_sm"
                    android:textColor="@color/on_surface_variant"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- M8 作者连线（P2 可选） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_author"
            android:contentDescription="@string/a11y_game_author_card"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/spacing_md"
            app:layout_constraintTop_toBottomOf="@id/card_flyflower"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/card_flyflower">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/icon_author"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_touch_target"
                    android:text="🔗"
                    android:textSize="@dimen/text_size_game_icon"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:background="@drawable/bg_checkin_future"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/info_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/spacing_xs"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:layout_constraintTop_toBottomOf="@id/icon_author"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/game_author"
                        android:textSize="@dimen/text_size_title"
                        android:textColor="@color/text_body"
                        android:textStyle="bold"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/game_author_desc"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_body_secondary"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/score_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textSize="@dimen/text_size_label"
                        android:textColor="@color/text_gold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badge_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/bg_chip"
                    android:textSize="@dimen/text_size_label_sm"
                    android:textColor="@color/on_surface_variant"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
