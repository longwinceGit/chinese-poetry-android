<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/spacing_page_bottom">

        <!-- ========== 搜索栏 ========== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_card"
            style="@style/Widget.Poetry.Card.Search"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_search_bar"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/spacing_xl"
                android:paddingEnd="@dimen/spacing_md">

                <ImageView
                    android:id="@+id/iv_search_icon"
                    android:layout_width="@dimen/size_icon_sm"
                    android:layout_height="@dimen/size_icon_sm"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/a11y_search_icon"
                    android:alpha="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:background="@null"
                    android:hint="@string/home_search_hint"
                    android:textColor="@color/text_body"
                    android:textColorHint="@color/outline_variant"
                    android:textSize="@dimen/text_size_body"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    app:layout_constraintStart_toEndOf="@id/iv_search_icon"
                    app:layout_constraintEnd_toStartOf="@id/progress_search"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ProgressBar
                    android:id="@+id/progress_search"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="@dimen/size_progress_sm"
                    android:layout_height="@dimen/size_progress_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:visibility="gone"
                    android:contentDescription="@string/a11y_searching"
                    app:layout_constraintEnd_toStartOf="@id/btn_search_clear"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageButton
                    android:id="@+id/btn_search_clear"
                    android:layout_width="@dimen/touch_target_small"
                    android:layout_height="@dimen/touch_target_small"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/a11y_clear_search"
                    android:visibility="gone"
                    android:alpha="0.5"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== 每日推荐卡片 ========== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/daily_card"
            style="@style/Widget.Poetry.Card.Raised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_page_top"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            app:layout_constraintTop_toBottomOf="@id/search_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_card_padding">

                <TextView
                    android:id="@+id/tv_daily_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_daily_recommend"
                    android:textAppearance="@style/TextAppearance.Poetry.DailyLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/ll_daily_poem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_daily_label">

                    <TextView
                        android:id="@+id/tv_daily_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_avatar"
                        tools:text="🌸" />

                    <TextView
                        android:id="@+id/tv_daily_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:textSize="@dimen/text_size_headline"
                        android:textColor="@color/text_title"
                        android:fontFamily="serif"
                        android:textStyle="bold"
                        tools:text="静夜思" />

                    <TextView
                        android:id="@+id/tv_daily_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="@color/text_body_secondary"
                        tools:text="李白 · 唐代" />

                    <TextView
                        android:id="@+id/tv_daily_excerpt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:textSize="@dimen/text_size_body_sm"
                        android:textColor="@color/text_body_secondary"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="床前明月光，疑是地上霜..." />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_daily_tap_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="点击查看详情 →"
                    android:textSize="@dimen/text_size_label_sm"
                    android:textColor="@color/text_caption"
                    app:layout_constraintTop_toBottomOf="@id/ll_daily_poem"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== 分类标签（横向滚动） ========== -->
        <HorizontalScrollView
            android:id="@+id/hsv_categories"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_page_top"
            android:scrollbars="none"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_lg"
            app:layout_constraintTop_toBottomOf="@id/daily_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="@dimen/spacing_chip_gap" />
        </HorizontalScrollView>

        <!-- ========== 搜索结果标题 ========== -->
        <TextView
            android:id="@+id/tv_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_page_horizontal"
            android:layout_marginTop="@dimen/spacing_page_top"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            android:text="@string/home_all_poems"
            android:textAppearance="@style/TextAppearance.Poetry.SectionTitle"
            app:layout_constraintTop_toBottomOf="@id/hsv_categories"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ========== 搜索结果计数 ========== -->
        <TextView
            android:id="@+id/tv_poem_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_label"
            android:textColor="@color/text_body_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_section_title"
            app:layout_constraintBottom_toBottomOf="@id/tv_section_title"
            android:layout_marginEnd="@dimen/spacing_page_horizontal"
            tools:text="共收录 1091 首" />

        <!-- ========== 加载状态 ========== -->
        <LinearLayout
            android:id="@+id/loading_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxxl"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tv_section_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ProgressBar
                android:id="@+id/progress_loading"
                android:layout_width="@dimen/size_progress_lg"
                android:layout_height="@dimen/size_progress_lg"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:id="@+id/tv_loading_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/home_loading"
                android:textSize="@dimen/text_size_body_sm"
                android:textColor="@color/text_body_secondary" />
        </LinearLayout>

        <!-- ========== 错误状态 ========== -->
        <LinearLayout
            android:id="@+id/error_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xxxl"
            android:layout_marginTop="@dimen/spacing_huge"
            android:layout_marginEnd="@dimen/spacing_xxxl"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_section_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_error_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😿"
                android:textSize="@dimen/text_size_emoji" />

            <TextView
                android:id="@+id/tv_error_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="数据加载失败，请检查存储空间后重试"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/text_body_secondary"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/line_height_compact"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_button"
                android:layout_marginTop="@dimen/spacing_xl_2"
                android:text="重新加载"
                android:textSize="@dimen/text_size_body_sm"
                style="@style/Widget.Poetry.Button.Outlined" />
        </LinearLayout>

        <!-- ========== 空状态 ========== -->
        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xxxl"
            android:layout_marginTop="@dimen/spacing_huge"
            android:layout_marginEnd="@dimen/spacing_xxxl"
            android:text="@string/home_search_empty"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/text_body_secondary"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_section_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ========== 诗词网格 ========== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_poems"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_section_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ========== 加载更多 ========== -->
        <LinearLayout
            android:id="@+id/load_more_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/recycler_poems"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ProgressBar
                android:id="@+id/progress_load_more"
                android:layout_width="@dimen/size_progress_md"
                android:layout_height="@dimen/size_progress_md"
                android:indeterminateTint="@color/primary"
                android:visibility="gone"
                android:layout_marginTop="@dimen/spacing_md" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_load_more"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_button"
                android:text="@string/home_load_more"
                android:textSize="@dimen/text_size_body_sm"
                style="@style/Widget.Poetry.Button.Outlined"
                android:layout_marginTop="@dimen/spacing_md" />

            <TextView
                android:id="@+id/tv_no_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_no_more"
                android:textSize="@dimen/text_size_label"
                android:textColor="@color/text_caption"
                android:visibility="gone"
                android:layout_marginTop="@dimen/spacing_xl" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
