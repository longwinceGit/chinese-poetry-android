.page-learning { min-height: 100vh; }
.stats-row { display: flex; justify-content: space-around; padding: 30rpx; margin-top: 10rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 44rpx; font-weight: bold; color: var(--primary); }
.stat-label { font-size: 24rpx; color: var(--text-muted); margin-top: 8rpx; }
.level-card { margin-top: 20rpx; }
.progress-bar { height: 16rpx; background: var(--border); border-radius: 8rpx; margin-top: 16rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, var(--primary), var(--secondary)); border-radius: 8rpx; transition: width 0.5s; }
.week-chart { display: flex; justify-content: space-around; align-items: flex-end; height: 160rpx; }
.week-bar-wrapper { display: flex; flex-direction: column; align-items: center; }
.week-bar { width: 40rpx; background: var(--primary); border-radius: 8rpx 8rpx 0 0; min-height: 8rpx; }
.week-label { font-size: 20rpx; color: var(--text-muted); margin-top: 8rpx; }
.task-item { padding: 16rpx 0; border-bottom: 1rpx solid var(--border); font-size: 28rpx; }
