<scroll-view scroll-y class="page-match">
  <view class="game-header flex-between card">
    <text>🎯 消消乐</text>
    <text>尝试: {{attempts}}次 | 得分: {{score}}</text>
  </view>
  <view class="match-grid">
    <view wx:for="{{cards}}" wx:key="id" class="match-card {{item.selected ? 'selected' : ''}} {{item.matched ? 'matched' : ''}} {{item.shake ? 'shake' : ''}}"
      bindtap="onCardTap" data-index="{{index}}">
      <text wx:if="{{!item.matched}}" class="card-text">{{item.text}}</text>
    </view>
  </view>
  <view class="game-over-overlay" wx:if="{{gameOver}}">
    <view class="game-over-card card">
      <text style="font-size:80rpx;">🎉</text>
      <text style="font-size:40rpx;font-weight:bold;margin:20rpx 0;">游戏结束</text>
      <text style="font-size:36rpx;color:var(--primary);">得分: {{score}}</text>
      <text style="font-size:28rpx;color:var(--text-muted);margin-top:10rpx;">尝试: {{attempts}}次</text>
      <view class="btn-primary" bindtap="restartGame" style="margin-top:30rpx;">再来一局</view>
    </view>
  </view>
</scroll-view>
