.page-detail { min-height: 100vh; }
.detail-header { text-align: center; padding: 40rpx; }
.detail-emoji { font-size: 100rpx; margin-bottom: 16rpx; }
.detail-title { font-size: 44rpx; font-weight: bold; color: var(--primary-dark); }
.detail-author { font-size: 30rpx; color: var(--text-secondary); margin-top: 10rpx; }
.action-row { display: flex; justify-content: space-around; padding: 20rpx; margin-top: 20rpx; }
.action-btn { display: flex; flex-direction: column; align-items: center; padding: 16rpx; }
.action-btn text:first-child { font-size: 48rpx; }
.action-label { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; }
.poem-body { padding: 40rpx; text-align: center; }
.poem-line-wrapper { margin: 16rpx 0; }
.pinyin-row { display: flex; justify-content: center; flex-wrap: wrap; margin-bottom: 4rpx; }
.pinyin-char { font-size: 20rpx; color: var(--text-muted); margin: 0 2rpx; }
.poem-line-text { font-size: 36rpx; color: var(--text-primary); letter-spacing: 4rpx; }
.explanation-card { margin-top: 20rpx; }
.explanation-body { margin-top: 16rpx; font-size: 28rpx; color: var(--text-secondary); line-height: 1.8; }
