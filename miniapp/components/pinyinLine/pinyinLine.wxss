.pinyin-line-wrapper { display: flex; flex-wrap: wrap; justify-content: center; }
.pinyin-cell { display: flex; flex-direction: column; align-items: center; margin: 2rpx 4rpx; }
.pinyin-p { font-size: 18rpx; color: var(--text-muted); line-height: 1.2; }
.pinyin-c { font-size: 34rpx; color: var(--text-primary); line-height: 1.4; }
